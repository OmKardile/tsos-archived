<Page x:Class="TSOS.POS.Views.MenuPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Menu Items" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="Manage your menu items, categories, and pricing" 
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,4,0,0"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="MenuList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"/>
                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSecondaryBrush}" 
                                               FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="{Binding Price, StringFormat='₹{0:F0}'}" FontWeight="Bold" 
                                                   Foreground="{StaticResource PrimaryBrush}" FontSize="14" Margin="0,0,12,0"/>
                                        <Border Background="#F0FDF4" CornerRadius="4" Padding="8,2">
                                            <TextBlock Text="{Binding CategoryName}" FontSize="11" 
                                                       Foreground="{StaticResource PrimaryBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                                <CheckBox Grid.Column="1" IsChecked="{Binding IsAvailable}" 
                                          VerticalAlignment="Center" IsEnabled="False"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Page>
