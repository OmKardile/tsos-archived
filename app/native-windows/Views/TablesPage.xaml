<Page x:Class="TSOS.POS.Views.TablesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Tables" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="Manage dine-in tables" 
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,4,0,0"/>
        </StackPanel>
        <WrapPanel x:Name="TablesPanel"/>
    </DockPanel>
</Page>
