<Page x:Class="TSOS.POS.Views.POSPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- Menu Grid -->
        <DockPanel Grid.Column="0" Margin="0,0,16,0">
            <!-- Search + Categories -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBox x:Name="SearchBox" 
                         Style="{StaticResource InputField}" Margin="0,0,0,12"
                         TextChanged="SearchBox_TextChanged"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="CategoryTabs" Orientation="Horizontal"/>
                </ScrollViewer>
            </StackPanel>

            <!-- Menu Items Grid -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="MenuGrid">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="160" Margin="6" Cursor="Hand"
                                    Background="White" BorderBrush="{StaticResource BorderBrush}" 
                                    BorderThickness="1" CornerRadius="10" Padding="12"
                                    MouseLeftButtonDown="MenuItem_Click" Tag="{Binding}">
                                <StackPanel>
                                    <Border Background="#F0FDF4" CornerRadius="8" Height="60" 
                                            Margin="0,0,0,8">
                                        <TextBlock Text="☕" FontSize="28" HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" 
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Price, StringFormat='₹{0:F0}'}" 
                                               FontSize="12" Foreground="{StaticResource PrimaryBrush}" 
                                               FontWeight="SemiBold" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <!-- Cart -->
        <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource BorderBrush}" 
                BorderThickness="1" CornerRadius="12">
            <DockPanel>
                <!-- Cart Header -->
                <Border DockPanel.Dock="Top" Padding="16,14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <TextBlock Text="Current Order" FontSize="16" FontWeight="SemiBold"/>
                        <Button Content="Clear" HorizontalAlignment="Right" Background="Transparent" 
                                BorderThickness="0" Foreground="{StaticResource DangerBrush}" 
                                FontSize="12" Cursor="Hand" Click="ClearCart_Click"/>
                    </Grid>
                </Border>

                <!-- Cart Footer -->
                <Border DockPanel.Dock="Bottom" Padding="16,12" BorderBrush="{StaticResource BorderBrush}" 
                        BorderThickness="0,1,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Subtotal" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="SubtotalText" Text="₹0" HorizontalAlignment="Right" FontSize="13"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Tax (5%)" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="TaxText" Text="₹0" HorizontalAlignment="Right" FontSize="13"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Total" FontSize="16" FontWeight="Bold"/>
                            <TextBlock x:Name="TotalText" Text="₹0" HorizontalAlignment="Right" 
                                       FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                        </Grid>

                        <!-- Order Type -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="TypeDineIn" Content="Dine-In" IsChecked="True" 
                                         Grid.Column="0" FontSize="12" GroupName="OrderType"/>
                            <RadioButton x:Name="TypeTakeaway" Content="Takeaway" 
                                         Grid.Column="1" FontSize="12" GroupName="OrderType"/>
                        </Grid>

                        <Button Content="Place Order" Style="{StaticResource PrimaryButton}" 
                                Height="44" Click="PlaceOrder_Click"/>
                    </StackPanel>
                </Border>

                <!-- Cart Items -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="CartList" Margin="12,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,8" BorderBrush="{StaticResource BorderBrush}" 
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Item.Name}" FontSize="13" FontWeight="Medium"/>
                                            <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                                                <Run Text="{Binding UnitPrice, StringFormat='₹{0:F0}'}"/>
                                                <Run Text=" × "/>
                                                <Run Text="{Binding Quantity}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="−" Width="28" Height="28" FontSize="14"
                                                    Click="DecreaseQty_Click" Tag="{Binding}" 
                                                    Background="Transparent" BorderThickness="1"
                                                    BorderBrush="{StaticResource BorderBrush}" Cursor="Hand"/>
                                            <TextBlock Text="{Binding Quantity}" Width="32" TextAlignment="Center" 
                                                       VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            <Button Content="+" Width="28" Height="28" FontSize="14"
                                                    Click="IncreaseQty_Click" Tag="{Binding}"
                                                    Background="Transparent" BorderThickness="1"
                                                    BorderBrush="{StaticResource BorderBrush}" Cursor="Hand"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Page>
