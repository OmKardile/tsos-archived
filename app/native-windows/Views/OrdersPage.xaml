<Page x:Class="TSOS.POS.Views.OrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnAll" Content="All" Tag="all" Click="Filter_Click" Padding="14,6" Margin="0,0,6,0" FontSize="12"/>
                    <Button x:Name="BtnNew" Content="New" Tag="new" Click="Filter_Click" Padding="14,6" Margin="0,0,6,0" FontSize="12"/>
                    <Button x:Name="BtnPreparing" Content="Preparing" Tag="preparing" Click="Filter_Click" Padding="14,6" Margin="0,0,6,0" FontSize="12"/>
                    <Button x:Name="BtnReady" Content="Ready" Tag="ready" Click="Filter_Click" Padding="14,6" FontSize="12"/>
                </StackPanel>
                <Button Content="🔄 Refresh" HorizontalAlignment="Right" Click="Refresh_Click" 
                        Background="Transparent" BorderThickness="0" FontSize="12" Cursor="Hand"/>
            </Grid>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="OrdersList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding OrderType}" FontWeight="SemiBold" FontSize="14"/>
                                        <Border Background="#FEF3C7" CornerRadius="4" Padding="8,2" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Medium" Foreground="#92400E"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0">
                                        <Run Text="{Binding Id, StringFormat='Order #{0}'}"/>
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding Items}" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                                                    <Run Text="{Binding Quantity}"/>
                                                    <Run Text="x "/>
                                                    <Run Text="{Binding Name}"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Total, StringFormat='₹{0:F0}'}" 
                                           FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="20,0"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Next →" Tag="{Binding}" Click="NextStatus_Click" 
                                            Padding="10,6" FontSize="12" Margin="0,0,6,0" Cursor="Hand"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Page>
