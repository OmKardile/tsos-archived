<Window x:Class="TSOS.POS.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TSOS POS" 
        Width="1280" Height="800" 
        MinWidth="1024" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        WindowState="Maximized">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}">
            <DockPanel>
                <!-- Logo -->
                <Border DockPanel.Dock="Top" Padding="24,20" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{StaticResource ActionBrush}" CornerRadius="8" 
                                Width="36" Height="36" Margin="0,0,12,0">
                            <TextBlock Text="T" Foreground="White" FontSize="18" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="TSOS" Foreground="{StaticResource TextPrimaryBrush}" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="{Binding ActiveLocation.Name, FallbackValue='POS'}" 
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Nav -->
                <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" Margin="0,8">
                    <StackPanel x:Name="NavPanel" Margin="12,0">
                        <!-- Overwrite with generated nav items -->
                    </StackPanel>
                </ScrollViewer>

                <!-- User -->
                <Border DockPanel.Dock="Bottom" Padding="16,12" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="UserName" Text="" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="Medium"/>
                            <TextBlock x:Name="UserRole" Text="" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="⏻" FontSize="16" Foreground="{StaticResource TextMutedBrush}"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Click="LogoutBtn_Click" Padding="8,4" ToolTip="Sign Out"/>
                    </Grid>
                </Border>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Border Grid.Column="1" Background="{StaticResource BgBrush}">
            <DockPanel>
                <!-- Header -->
                <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}" Padding="24,12" 
                        BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="PageTitle" Text="Dashboard" FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="LocationLabel" Text="" FontSize="12" 
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,12,0"
                                       VerticalAlignment="Center"/>
                            <ComboBox x:Name="LocationCombo" Width="200" SelectionChanged="LocationCombo_Changed"
                                      Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Page Content -->
                <Frame x:Name="ContentFrame" NavigationUIVisibility="Hidden"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
