<Page x:Class="TSOS.POS.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="600">
            <TextBlock Text="Settings" FontSize="20" FontWeight="Bold" Margin="0,0,0,24"/>

            <!-- Account -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Account" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Name" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="UserName" Text="" FontSize="13" FontWeight="Medium" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Email" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="UserEmail" Text="" FontSize="13" FontWeight="Medium" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Role" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="UserRole" Text="" FontSize="13" FontWeight="Medium" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Fee Configuration -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Fee Configuration" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock Text="Set who pays the platform fee per order" 
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Fee Payer" FontSize="13" VerticalAlignment="Center"/>
                        <ComboBox x:Name="FeePayerCombo" Width="160" HorizontalAlignment="Right">
                            <ComboBoxItem Content="Customer" Tag="customer"/>
                            <ComboBoxItem Content="Cafe" Tag="cafe"/>
                        </ComboBox>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Fee per Order (₹)" FontSize="13" VerticalAlignment="Center"/>
                        <TextBox x:Name="FeeAmountBox" Width="100" HorizontalAlignment="Right" 
                                 Style="{StaticResource InputField}" Text="1"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Auto-flip after N orders" FontSize="13" VerticalAlignment="Center"/>
                        <TextBox x:Name="AutoFlipBox" Width="100" HorizontalAlignment="Right" 
                                 Style="{StaticResource InputField}" Text="5"/>
                    </Grid>

                    <Button Content="Save Settings" Style="{StaticResource PrimaryButton}" 
                            HorizontalAlignment="Right" Click="SaveSettings_Click"/>
                </StackPanel>
            </Border>

            <!-- App Info -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="About" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Version" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="1.0.0" FontSize="13" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Location" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="LocationText" Text="" FontSize="13" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
