<Window x:Class="TSOS.POS.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TSOS POS" 
        Width="480" Height="620" 
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="16" Margin="32">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.15" Color="#000"/>
            </Border.Effect>
            <StackPanel Margin="32" VerticalAlignment="Center">
                <!-- Logo -->
                <TextBlock Text="TSOS" FontSize="36" FontWeight="Bold" 
                           Foreground="{StaticResource ActionBrush}" 
                           HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Text="Cafe Management Platform" FontSize="13" 
                           Foreground="{StaticResource TextSecondaryBrush}" 
                           HorizontalAlignment="Center" Margin="0,0,0,32"/>

                <!-- Tab Toggle -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource Cream200Brush}" CornerRadius="8" Margin="0,0,2,0">
                        <StackPanel x:Name="EmailTab" Cursor="Hand" MouseLeftButtonDown="EmailTab_Click">
                            <Border x:Name="EmailTabBg" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="12,8">
                                <TextBlock Text="Email &amp; Password" FontSize="12" FontWeight="Medium" 
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{StaticResource Cream200Brush}" CornerRadius="8" Margin="2,0,0,0">
                        <StackPanel x:Name="PinTab" Cursor="Hand" MouseLeftButtonDown="PinTab_Click">
                            <Border x:Name="PinTabBg" CornerRadius="8" Padding="12,8">
                                <TextBlock Text="PIN Login" FontSize="12" FontWeight="Medium" 
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Email Field -->
                <TextBlock Text="Email" FontSize="12" FontWeight="Medium" 
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                <TextBox x:Name="EmailBox" Style="{StaticResource InputField}" 
                         Text="admin@tsos.dev" Margin="0,0,0,16"/>

                <!-- Password Field -->
                <StackPanel x:Name="PasswordPanel">
                    <TextBlock Text="Password" FontSize="12" FontWeight="Medium" 
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="PasswordBox" Style="{StaticResource PasswordField}" 
                                 Password="password123"/>
                </StackPanel>

                <!-- PIN Field -->
                <StackPanel x:Name="PinPanel" Visibility="Collapsed">
                    <TextBlock Text="4-Digit PIN" FontSize="12" FontWeight="Medium" 
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <TextBox x:Name="PinBox" Style="{StaticResource InputField}" 
                             MaxLength="4" FontSize="24" FontWeight="Bold" 
                             HorizontalContentAlignment="Center" CharacterCasing="Normal"/>
                </StackPanel>

                <!-- Error -->
                <TextBlock x:Name="ErrorText" Text="" FontSize="12" Foreground="{StaticResource DestructiveBrush}" 
                           Margin="0,8,0,0" TextWrapping="Wrap"/>

                <!-- Login Button -->
                <Button x:Name="LoginBtn" Content="Sign In" Style="{StaticResource PrimaryButton}" 
                        Margin="0,20,0,0" Click="LoginBtn_Click" Height="44"/>

                <!-- Loading -->
                <TextBlock x:Name="LoadingText" Text="Signing in..." 
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                           HorizontalAlignment="Center" Margin="0,12,0,0" Visibility="Collapsed"/>

                <!-- Demo -->
                <TextBlock Text="Demo: admin@tsos.dev / password123" FontSize="11" 
                           Foreground="{StaticResource TextMutedBrush}" 
                           HorizontalAlignment="Center" Margin="0,20,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
